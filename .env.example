# Conductor Configuration
# Copy this file to .env and adjust values for your environment.

# --- Required ---
DATABASE_URL="postgresql://conductor:conductor@localhost:5432/conductor"

# --- Worker Configuration ---
WORKER_ID=""                              # Worker identifier (default: hostname-pid)
CONCURRENCY=10                            # Max concurrent tasks per worker
POLL_INTERVAL=0.5                         # Seconds between task polls
ROUTES=default                            # Comma-separated routes to poll
HEARTBEAT_INTERVAL=10                     # Heartbeat frequency (seconds)
CONDUCTOR_HANDLERS_MODULE=""              # Dotted path to a handlers module (register(worker))

# --- Logging ---
LOG_LEVEL=INFO                            # DEBUG, INFO, WARNING, ERROR
LOG_FORMAT=json                           # json or text

# --- Metrics & Health ---
METRICS_ENABLED=true                      # Enable Prometheus metrics endpoint
METRICS_PORT=8000                         # Metrics/health HTTP server port (shared)
HEALTH_ENABLED=true                       # Enable health check endpoint

# --- Task Defaults ---
TASK_TIMEOUT=300                          # Default task timeout in seconds
MAX_TASK_AGE=86400                        # Max age for pending tasks in seconds

# --- Connection Pool ---
DB_MIN_SIZE=2                             # Minimum connection pool size
DB_MAX_SIZE=10                            # Maximum connection pool size
DB_TIMEOUT=30                             # Connection acquire timeout (seconds)
DB_COMMAND_TIMEOUT=60                     # SQL command timeout (seconds)

# --- Graceful Shutdown ---
GRACEFUL_SHUTDOWN_TIMEOUT=30              # Seconds to wait for in-flight tasks
